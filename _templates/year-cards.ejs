<%
// Kartu per tahun (Publications & Services). Data dari publications.yml / services.yml.
// Tahun berupa teks (mis. "Ongoing") ditaruh paling atas; angka diurutkan menurun.
const groups = [];
for (const item of items) {
  const y = String(item.year ?? "Other");
  let g = groups.find(x => x.y === y);
  if (!g) { g = { y, items: [] }; groups.push(g); }
  g.items.push(item);
}
groups.sort((a, b) => {
  const na = Number(a.y), nb = Number(b.y);
  if (isNaN(na) && isNaN(nb)) return 0;
  if (isNaN(na)) return -1;
  if (isNaN(nb)) return 1;
  return nb - na;
});
%>
<div class="view-toolbar" role="group" aria-label="Layout">
<button type="button" class="view-btn" data-view="grid" title="Grid view"><i class="bi bi-grid-3x2-gap"></i> Grid</button>
<button type="button" class="view-btn" data-view="list" title="List view"><i class="bi bi-list-ul"></i> List</button>
</div>
<% groups.forEach((g) => { %>
<details class="group-panel" open>
<summary class="group-title"><span><%= g.y %></span><span class="group-count"><%= g.items.length %> item<%= g.items.length === 1 ? '' : 's' %></span><i class="bi bi-chevron-down group-caret"></i></summary>
<div class="entry-grid">
<% for (const item of g.items) { %>
<article class="entry-card">
<div class="entry-top">
<% if (item.kind) { %><span class="entry-kind"><%= item.kind %></span><% } %>
<% if (item.url) { %><a class="entry-link" href="<%- item.url %>" title="Open" aria-label="Open link"><i class="bi bi-box-arrow-up-right"></i></a><% } %>
</div>
<h3 class="entry-title"><% if (item.url) { %><a href="<%- item.url %>"><%= item.title %></a><% } else { %><%= item.title %><% } %></h3>
<p class="entry-meta"><%= [item.venue, item.publisher].filter(Boolean).join(" · ") %></p>
<% if (item.summary) { %><p class="entry-summary"><%= item.summary %></p><% } %>
</article>
<% } %>
</div>
</details>
<% }) %>
