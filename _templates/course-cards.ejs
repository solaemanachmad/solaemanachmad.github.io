<%
// Kartu mata kuliah, dikelompokkan per tahun akademik; Odd/Even jadi tag di kartu.
// Sumber dari courses/*/index.qmd:
//   semester:  "Odd Semester 2026/2027"                 (satu semester)
//   semesters: ["Even Semester 2026/2027", "Even ..."]  (diajar di beberapa semester)
// Mata kuliah dengan beberapa semester muncul di setiap tahun akademiknya,
// semua kartunya menuju halaman yang sama.
function parseSem(sem) {
  const ym = String(sem).match(/(\d{4})\/(\d{4})/);
  const tm = String(sem).match(/\b(Odd|Even)\b/i);
  return {
    year: ym ? ym[0] : String(sem || "Other"),
    start: ym ? Number(ym[1]) : 0,
    term: tm ? tm[1][0].toUpperCase() + tm[1].slice(1).toLowerCase() : ""
  };
}
const groups = [];
for (const item of items) {
  let list = item.semesters || item.semester || [];
  if (!Array.isArray(list)) list = [list];
  for (const sem of list) {
    const p = parseSem(sem);
    let g = groups.find(x => x.sem === p.year);
    if (!g) { g = { sem: p.year, start: p.start, items: [] }; groups.push(g); }
    g.items.push(Object.assign({}, item, { _term: p.term }));
  }
}
// Tahun akademik terbaru di atas; di dalamnya Even (genap) sebelum Odd (ganjil), lalu `order`
groups.sort((a, b) => b.start - a.start);
for (const g of groups) g.items.sort((a, b) =>
  (a._term === b._term ? 0 : a._term === "Even" ? -1 : 1) || (Number(b.order || 0) - Number(a.order || 0)));
%>
<%
// Ringkasan (kotak angka) + panel tahun. Tahun akademik terbaru terbuka; dua tahun sebelumnya
// tampil sebagai panel tertutup; yang lebih lama dikumpulkan di "Course archive" (daftar ringkas).
const SHOW_YEARS = 3;
const kinds = {}; items.forEach(i => { const k = String(i.kind || "Course"); kinds[k] = (kinds[k] || 0) + 1; });
const semCount = new Set(items.flatMap(i => [].concat(i.semesters || i.semester || []).map(String))).size;
const tiles = [["bi-journal-bookmark", items.length, items.length === 1 ? "Course" : "Courses"]];
for (const k of Object.keys(kinds)) tiles.push([/lab/i.test(k) ? "bi-pc-display" : "bi-easel", kinds[k], k + (kinds[k] === 1 ? "" : "s")]);
tiles.push(["bi-calendar3", semCount, semCount === 1 ? "Semester" : "Semesters"]);
const shown = groups.slice(0, SHOW_YEARS), archive = groups.slice(SHOW_YEARS);
const card = (item) => `<div class="course-card" ${metadataAttrs(item)}>
<div class="course-card-top"><span class="course-code">${item.code || ""}</span><span class="course-kind">${item.kind || ""}</span>${item._term ? `<span class="term-tag term-${item._term.toLowerCase()}">${item._term} semester</span>` : ""}</div>
<div class="course-card-body"><h3><a class="stretched-link" href="${item.path}">${item.title}</a></h3>${item.subtitle ? `<p class="course-sub">${item.subtitle}</p>` : ""}${item.description ? `<p class="course-desc">${item.description}</p>` : ""}</div>
<div class="course-card-foot">View meetings <i class="bi bi-arrow-right"></i></div>
</div>`;
%>
<div class="svc-summary-bar teach-tiles">
<% for (const [icon, num, label] of tiles) { %><div class="svc-tile"><i class="bi <%= icon %>"></i><span class="svc-tile-num"><%= num %></span><span class="svc-tile-label"><%= label %></span></div><% } %>
</div>
<% shown.forEach((g, gi) => { %>
<details class="group-panel"<%= gi === 0 ? ' open' : '' %>>
<summary class="group-title"><span>Academic Year <%= g.sem %><% if (gi === 0) { %> <span class="current-pill">Current</span><% } %></span><span class="group-count"><%= g.items.length %> course<%= g.items.length === 1 ? '' : 's' %></span><i class="bi bi-chevron-down group-caret"></i></summary>
<div class="course-grid">
<% for (const item of g.items) { %><%= card(item) %><% } %>
</div>
</details>
<% }) %>
<% if (archive.length) { %>
<details class="group-panel teach-archive">
<summary class="group-title"><span><i class="bi bi-archive"></i> Course archive · <%= archive[archive.length - 1].sem.split("/")[0] %>–<%= archive[0].sem.split("/")[1] || archive[0].sem %></span><span class="group-count"><%= archive.length %> year<%= archive.length === 1 ? '' : 's' %></span><i class="bi bi-chevron-down group-caret"></i></summary>
<div class="archive-list">
<% for (const g of archive) { %><div class="archive-row"><span class="archive-year"><%= g.sem %></span><span class="archive-courses"><% for (const item of g.items) { %><a class="archive-chip" href="<%- item.path %>"><span class="course-code"><%= item.code || "" %></span><%= item.title %></a><% } %></span></div><% } %>
</div>
</details>
<% } %>
